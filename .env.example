# ---------------------------------------------------------------
#  F-Tech Automation Posts — environment variables
# ---------------------------------------------------------------
#  COPY this file to `.env` (local) or paste these into your host's
#  Environment Variables panel (production). NEVER commit the real .env.
#
#  Locally you can skip all of this: if MASTER_KEY / SESSION_SECRET are
#  missing, the app generates strong random ones once and stores them in
#  data/.secrets.json (git-ignored). In production you MUST set them
#  yourself, or every restart would generate new keys and your saved API
#  keys would become undecryptable.
# ---------------------------------------------------------------

# Encrypts every API key/token before storage (AES-256-GCM).
# MUST be exactly 64 hex characters (32 bytes).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace_me_with_64_hex_chars

# Signs the login session cookie. Any long random string.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_me_with_a_long_random_string

# Port the server listens on. Most hosts set this automatically.
PORT=3000

# Use "production" when deployed — this also makes the session cookie
# Secure (HTTPS-only). Leave unset/development for local http://localhost.
NODE_ENV=production
