# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3001

# ─── Crypto (auto-generated into .env on first boot if absent) ──────────────
# 32-byte base64 values. Rotate MASTER_KEK via the crypto rotate CLI.
MASTER_KEK=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Bootstrap super admin (first boot only; forces password change) ────────
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=golu9588
BOOTSTRAP_ADMIN_RECOVERY_EMAIL=vansh76840405@gmail.com

# ─── Optional platform OAuth apps (leave blank to run in simulation mode) ───
META_APP_ID=
META_APP_SECRET=
# LinkedIn: these are optional — you can paste an access token, or save the
# client id/secret, from the LinkedIn screen in the UI (no restart needed).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only set this if LinkedIn retires every version the app knows about.
LINKEDIN_API_VERSION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Optional keyword data ──────────────────────────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Provider API keys (Anthropic/OpenAI/Google/custom) are NOT set here.
# They are entered in the UI (Brain → Providers), encrypted at rest, per-tenant.
