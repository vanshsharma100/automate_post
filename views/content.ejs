<%- include('partials/header') %>

<div class="tabs" role="tablist" style="margin-bottom:16px">
  <button type="button" class="tab active" data-pane-tab="ai">✨ Generate with AI</button>
  <button type="button" class="tab" data-pane-tab="manual">✍️ Write your own</button>
</div>

<!-- ===================== AI GENERATE ===================== -->
<div class="pane" data-pane="ai">
  <div class="grid cols-2">
    <div class="card">
      <h2>Generate a post</h2>
      <p class="sub">Pick a platform and a post type. The <a href="/brain">Brain</a> writes it using your <a href="/knowledge">Share Knowledge</a>.</p>

      <% if (!aiConnected) { %>
        <div class="callout" style="margin-bottom:14px">
          No active AI key yet — you'll get a realistic <b>template preview</b> for now.
          <% if (currentUser && currentUser.role === 'super') { %>
            Add a provider key in <a href="/brain">Brain</a> and generations switch to real AI automatically.
          <% } else { %>
            The owner can add a key in Brain and generations switch to real AI automatically.
          <% } %>
        </div>
      <% } %>

      <form method="post" action="/content/generate">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <label>Post type</label>
        <select name="postType" data-posttype-select>
          <option value="product">🛍️ Product post — promote one product</option>
          <option value="general">💡 General post — helpful content, no product</option>
        </select>
        <div class="help">Use <b>General</b> where you don't want to sell directly (e.g. LinkedIn tips, buying guides, how-tos).</div>

        <div class="product-field">
          <label>Product</label>
          <select name="productId">
            <% products.forEach(function(p){ %>
              <option value="<%= p.id %>"><%= p.shortTitle || p.title %> — ₹<%= p.price.toLocaleString('en-IN') %></option>
            <% }); %>
          </select>
        </div>

        <label>Platform</label>
        <select name="platform">
          <% Object.keys(platforms).forEach(function(k){ %>
            <option value="<%= k %>"><%= platforms[k].icon %> <%= platforms[k].label %></option>
          <% }); %>
        </select>

        <% if (accounts.length) { %>
          <label>Account <span class="hint">— must match the platform above</span></label>
          <select name="accountId">
            <option value="all">All active accounts on that platform (one post each)</option>
            <% accounts.forEach(function(a){ %>
              <option value="<%= a.id %>"><%= platforms[a.platform] ? platforms[a.platform].label : a.platform %> — <%= a.label %><%= a.enabled ? '' : ' (inactive)' %></option>
            <% }); %>
          </select>
        <% } %>

        <label>Schedule for later <span class="hint">— optional; leave empty to just save a draft</span></label>
        <input type="datetime-local" name="scheduledAt" />

        <div style="height:14px"></div>
        <button class="btn wide" type="submit">✨ Generate &amp; save</button>
      </form>

      <hr class="divider" />
      <p class="sub" style="margin:0 0 8px">Or run a scheduled slot now (uses that platform's content type):</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <% Object.keys(platforms).forEach(function(k){ %>
          <form method="post" action="/run/<%= k %>" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn ghost sm" type="submit"><%= platforms[k].icon %> <%= platforms[k].label %></button>
          </form>
        <% }); %>
      </div>
    </div>

    <div class="card">
      <h2>How these are handled</h2>
      <ul style="padding-left:18px;color:var(--muted);font-size:14px;line-height:1.8">
        <li><b>Product post</b> → promotes a specific product with its price and link.</li>
        <li><b>General post</b> → the AI writes helpful, non-promotional content for your field.</li>
        <li><b>Write your own</b> → type the post yourself and attach a photo or video.</li>
        <li><b>Autopilot ON</b> + connector added → publishes automatically on schedule.</li>
        <li><b>Draft mode</b> → saved here; press <b>Approve</b> to mark it ready.</li>
        <li>Set a <b>schedule time</b> to auto-publish a single post at an exact moment.</li>
      </ul>
      <div class="callout">Nothing is posted anywhere until the platform connectors are added in Settings.</div>
    </div>
  </div>
</div>

<!-- ===================== MANUAL COMPOSER ===================== -->
<div class="pane" data-pane="manual" hidden>
  <div class="card">
    <h2>✍️ Write your own post</h2>
    <p class="sub">Type exactly what you want to publish and attach your own <b>picture</b> and/or <b>video</b>. Saved as a draft (or scheduled) — nothing goes out until the platform is connected.</p>
    <form method="post" action="/content/create?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
      <div class="row">
        <div>
          <label>Platform *</label>
          <select name="platform">
            <% platformList.forEach(function(pl){ %>
              <option value="<%= pl.key %>"><%= pl.icon %> <%= pl.label %></option>
            <% }); %>
          </select>
        </div>
        <% if (accounts.length) { %>
          <div>
            <label>Account <span class="hint">— optional</span></label>
            <select name="accountId">
              <option value="none">No specific account</option>
              <% accounts.forEach(function(a){ %>
                <option value="<%= a.id %>"><%= platforms[a.platform] ? platforms[a.platform].label : a.platform %> — <%= a.label %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
      </div>

      <label>Post text *</label>
      <textarea name="text" rows="6" placeholder="Write your caption / post here..."></textarea>

      <label>Description / notes <span class="hint">— optional internal note or longer caption</span></label>
      <textarea name="description" rows="3" placeholder="e.g. Diwali offer — running till Sunday"></textarea>

      <div class="row">
        <div>
          <label>Picture <span class="hint">— jpg / png, up to 80&nbsp;MB</span></label>
          <input type="file" name="photo" accept="image/*" />
        </div>
        <div>
          <label>Video <span class="hint">— mp4 / mov, up to 80&nbsp;MB</span></label>
          <input type="file" name="video" accept="video/*" />
        </div>
      </div>

      <label>Schedule for later <span class="hint">— optional</span></label>
      <input type="datetime-local" name="scheduledAt" />

      <div style="height:14px"></div>
      <button class="btn wide" type="submit">💾 Save my post</button>
    </form>
  </div>
</div>

<div class="section-title">Drafts &amp; posts</div>

<% if (!posts.length) { %>
  <div class="card"><div class="callout">No content yet — generate a post or write your own above.</div></div>
<% } else { %>
  <!-- Per-platform filter (each platform has its own content section) -->
  <div class="tabs" role="tablist">
    <button type="button" class="tab active" data-filter="all">🗂️ All (<%= posts.length %>)</button>
    <% platformList.forEach(function(pl){ var n = posts.filter(function(p){ return p.platform === pl.key; }).length; %>
      <button type="button" class="tab" data-filter="<%= pl.key %>"><%= pl.icon %> <%= pl.label %> (<%= n %>)</button>
    <% }); %>
  </div>

  <div class="grid cols-2" data-content-grid>
    <% posts.forEach(function(p){ %>
      <div class="post-card" data-platform="<%= p.platform %>">
        <div class="meta">
          <span class="pill <%= p.status === 'published' ? 'pub' : (p.status === 'failed' ? 'fail' : (p.status === 'approved' ? 'auto' : (p.status === 'scheduled' ? 'sched' : 'draft'))) %>"><%= p.status %></span>
          <% var pt = p.postType || 'product'; %>
          <span class="pill <%= pt === 'general' ? 'gen' : (pt === 'manual' ? 'man' : 'prod') %>"><%= pt === 'manual' ? 'yours' : pt %></span>
          <b><%= p.platformLabel %></b><% if (p.accountLabel) { %> <span class="acct-tag"><%= p.accountLabel %></span><% } %> · <%= p.productTitle %>
          <span style="margin-left:auto;font-size:11px">via <%= p.engineLabel || p.engine || 'template' %><%= p.imageLabel ? ' + ' + p.imageLabel + ' img' : '' %></span>
        </div>
        <% if (p.scheduledAt) { %>
          <div class="help" style="margin-bottom:8px">🕑 Scheduled: <b><%= new Date(p.scheduledAt).toLocaleString() %></b></div>
        <% } %>
        <% if (p.video) { %>
          <video class="post-img" src="<%= p.video %>" controls preload="metadata"></video>
        <% } else if (p.image) { %>
          <img class="post-img" src="<%= p.image %>" alt="" onerror="this.style.display='none'" />
        <% } %>
        <div class="body"><%= p.text %></div>
        <% if (p.description) { %><div class="help" style="margin-top:6px">📝 <%= p.description %></div><% } %>
        <% if (p.note) { %><div class="help" style="color:var(--warn)"><%= p.note %></div><% } %>
        <% if (p.imageNote) { %><div class="help"><%= p.imageNote %></div><% } %>
        <% if (p.permalink) { %>
          <div class="help">✅ Live: <a href="<%= p.permalink %>" target="_blank" rel="noopener">view the published post ↗</a></div>
        <% } %>
        <div class="actions">
          <a class="btn ghost sm" href="/content/<%= p.id %>/edit">✎ Edit</a>
          <% if (p.status !== 'published') { %>
            <form method="post" action="/content/<%= p.id %>/publish" style="margin:0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn sm" type="submit" data-confirm="Publish this post to <%= p.platformLabel %> now?">🚀 Publish now</button>
            </form>
          <% } %>
          <% if (!p.approved && p.status !== 'published') { %>
            <form method="post" action="/content/<%= p.id %>/approve" style="margin:0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn ghost sm" type="submit">Approve</button>
            </form>
          <% } %>
          <form method="post" action="/content/<%= p.id %>/delete" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn ghost sm danger" type="submit" data-confirm="Delete this post?">Delete</button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
