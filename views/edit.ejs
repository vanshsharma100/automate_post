<%- include('partials/header') %>

<div class="grid cols-2">
  <div class="card">
    <h2>Edit post — <%= post.platformLabel %></h2>
    <p class="sub"><%= post.productTitle %></p>

    <form method="post" action="/content/<%= post.id %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <label>Post text</label>
      <textarea name="text" rows="8"><%= post.text %></textarea>

      <label>Image URL <span class="hint">— paste any image link, or use the buttons on the right</span></label>
      <input type="text" name="image" value="<%= post.image || '' %>" />

      <label>Publish at exact date &amp; time <span class="hint">— leave empty for normal Draft/Autopilot flow</span></label>
      <input type="datetime-local" name="scheduledAt"
             value="<%= post.scheduledAt ? new Date(post.scheduledAt).toLocaleString('sv-SE').slice(0,16).replace(' ','T') : '' %>" />
      <div class="help">When set, the post fires automatically at that moment (if the platform connector is added &amp; the platform isn't paused).</div>

      <div style="height:16px"></div>
      <button class="btn" type="submit" name="action" value="save">💾 Save changes</button>
      <a class="btn ghost" href="/content">Cancel</a>
    </form>
  </div>

  <div class="card">
    <h2>Photo</h2>
    <% if (post.image) { %>
      <img class="post-img" style="max-height:320px" src="<%= post.image %>" alt="" onerror="this.style.display='none'" />
      <div class="help" style="margin-bottom:12px">Current image (<%= post.imageEngine === 'gemini' ? 'AI-generated by Gemini' : 'real product photo' %>)</div>
    <% } else { %>
      <div class="callout" style="margin-bottom:12px">No image on this post yet.</div>
    <% } %>

    <% if (product) { %>
      <div style="display:flex; gap:8px; flex-wrap:wrap">
        <form method="post" action="/content/<%= post.id %>/edit" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn ghost sm" type="submit" name="action" value="product-photo">📷 Use real product photo</button>
        </form>
        <form method="post" action="/content/<%= post.id %>/edit" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn ghost sm" type="submit" name="action" value="gemini" <%= geminiOn ? '' : 'disabled' %>>✨ Regenerate with Gemini</button>
        </form>
      </div>
      <% if (!geminiOn) { %>
        <div class="help" style="margin-top:8px">Gemini is switched OFF — turn it ON in <a href="/settings">Settings → AI</a> to generate AI images.</div>
      <% } %>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
