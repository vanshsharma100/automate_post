<%- include('partials/header') %>

<div class="grid cols-2">
  <div class="card">
    <h2>Edit post — <%= post.platformLabel %></h2>
    <p class="sub"><%= post.productTitle %></p>

    <form method="post" action="/content/<%= post.id %>/edit?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
      <label>Post text</label>
      <textarea name="text" rows="8"><%= post.text %></textarea>

      <label>Description / notes <span class="hint">— optional</span></label>
      <textarea name="description" rows="3"><%= post.description || '' %></textarea>

      <label>Upload a new picture <span class="hint">— replaces the current image</span></label>
      <input type="file" name="photo" accept="image/*" />

      <label>Upload a new video <span class="hint">— mp4 / mov</span></label>
      <input type="file" name="video" accept="video/*" />
      <% if (post.video) { %>
        <label class="daychip" style="margin-top:8px"><input type="checkbox" name="removeVideo" /> Remove the current video</label>
      <% } %>

      <label>Image URL <span class="hint">— or paste any image link instead of uploading</span></label>
      <input type="text" name="image" value="<%= post.image || '' %>" />

      <label>Publish at exact date &amp; time <span class="hint">— leave empty for normal Draft/Autopilot flow</span></label>
      <input type="datetime-local" name="scheduledAt"
             value="<%= post.scheduledAt ? new Date(post.scheduledAt).toLocaleString('sv-SE').slice(0,16).replace(' ','T') : '' %>" />

      <div style="height:16px"></div>
      <button class="btn" type="submit" name="action" value="save">💾 Save changes</button>
      <a class="btn ghost" href="/content">Cancel</a>
    </form>
  </div>

  <div class="card">
    <h2>Media preview</h2>
    <% if (post.video) { %>
      <video class="post-img" style="max-height:320px" src="<%= post.video %>" controls preload="metadata"></video>
      <div class="help" style="margin-bottom:12px">Current video attached.</div>
    <% } %>
    <% if (post.image) { %>
      <img class="post-img" style="max-height:320px" src="<%= post.image %>" alt="" onerror="this.style.display='none'" />
      <div class="help" style="margin-bottom:12px">Current image
        (<%= post.imageEngine === 'upload' ? 'you uploaded it' : (['gemini','openai'].includes(post.imageEngine) ? 'AI-generated' : 'real product photo') %>)</div>
    <% } else if (!post.video) { %>
      <div class="callout" style="margin-bottom:12px">No image or video on this post yet.</div>
    <% } %>

    <% if (product) { %>
      <div style="display:flex; gap:8px; flex-wrap:wrap">
        <form method="post" action="/content/<%= post.id %>/edit" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn ghost sm" type="submit" name="action" value="product-photo">📷 Use real product photo</button>
        </form>
        <form method="post" action="/content/<%= post.id %>/edit" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button class="btn ghost sm" type="submit" name="action" value="ai-image" <%= imageOn ? '' : 'disabled' %>>✨ Regenerate with <%= imageLabel %></button>
        </form>
      </div>
      <% if (!imageOn) { %>
        <div class="help" style="margin-top:8px">Image generation is OFF — turn it ON in <a href="/brain">Brain</a> to make AI images.</div>
      <% } %>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
