<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sign in · F-Tech Automation</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <div class="auth">
    <div class="auth-card">
      <div class="logo">F</div>
      <h1>F-Tech Automation</h1>
      <p class="sub">Sign in to your posting dashboard.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="flash error"><%= error %></div>
      <% } %>

      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <label>Username</label>
        <input type="text" name="username" autocomplete="username" autofocus required />
        <label>Password</label>
        <input type="password" name="password" autocomplete="current-password" required />
        <div style="height:16px"></div>
        <button class="btn wide" type="submit">Sign in</button>
      </form>

      <div class="foot"><a href="/forgot">Forgot username or password?</a></div>
    </div>
  </div>
</body>
</html>
