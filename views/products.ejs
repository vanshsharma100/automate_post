<%- include('partials/header') %>

<div class="card">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap">
    <div>
      <h2>Products</h2>
      <p class="sub" style="margin:0">
        These feed the Content Brain.
        <% if (shopifyConnected) { %>
          Synced from your Shopify store<% if (shopify.lastSync) { %> — last update <b><%= new Date(shopify.lastSync).toLocaleString() %></b><% } %>.
        <% } else { %>
          Showing sample products from <b>ftechdeals.com</b>. Add your Shopify Admin token in
          <a href="/settings">Settings → Shopify</a>, then Sync to pull your full live catalogue.
        <% } %>
      </p>
    </div>
    <form method="post" action="/products/sync" style="margin:0">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button class="btn" type="submit" <%= shopifyConnected ? '' : 'disabled title="Add a Shopify token in Settings first"' %>>🔄 Sync from Shopify</button>
    </form>
  </div>

  <div class="table-wrap" style="margin-top:14px">
  <table>
    <thead><tr><th>Product</th><th>Type</th><th>Price</th><th></th></tr></thead>
    <tbody>
      <% products.forEach(function(p){ %>
        <tr>
          <td>
            <div class="product">
              <img src="<%= p.image %>" alt="" onerror="this.style.visibility='hidden'" />
              <div>
                <b><%= p.shortTitle || p.title %></b>
                <div class="help"><%= (p.tags || []).join(' · ') %></div>
              </div>
            </div>
          </td>
          <td style="color:var(--muted)"><%= p.type || '—' %></td>
          <td><span class="price">₹<%= p.price.toLocaleString('en-IN') %></span></td>
          <td><a class="btn ghost sm" href="<%= p.url %>" target="_blank" rel="noopener">View</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
</div>

<%- include('partials/footer') %>
